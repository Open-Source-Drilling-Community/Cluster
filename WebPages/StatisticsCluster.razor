@page "/StatisticsCluster"
@using System.Reflection
@inject ILogger<StatisticsCluster> logger
@inject ISnackbar Snackbar
@inject IClusterAPIUtils Api

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-4">
        <MudText Typo="Typo.h5"><strong>Usage Statistics</strong></MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@isLoading_" OnClick="RefreshAsync">
            Refresh
        </MudButton>
    </MudStack>

    @if (isLoading_)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (statistics_ == null)
    {
        <MudAlert Severity="Severity.Warning">Unable to load Cluster usage statistics.</MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle2">Total count</MudText>
                <MudText Typo="Typo.h6">@totalCount_</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle2">Today</MudText>
                <MudText Typo="Typo.h6">@todayCount_</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle2">Tracked endpoints</MudText>
                <MudText Typo="Typo.h6">@rows_.Count</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle2">Last saved</MudText>
                <MudText Typo="Typo.h6">@FormatDate(statistics_.LastSaved)</MudText>
            </MudItem>
        </MudGrid>

        <MudExpansionPanels MultiExpansion="true">
            @foreach (var group in groups_)
            {
                <MudExpansionPanel Text="@($"{group.Area} ({group.Total})")" Expanded="@group.IsInitiallyExpanded">
                    <MudTable Items="group.Rows" Dense="true" Hover="true" SortLabel="Sort by">
                        <HeaderContent>
                            <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, string>(row => row.Method)">Method</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, string>(row => row.Endpoint)">Endpoint</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, object>(row => row.Today)">Today</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, object>(row => row.Total)">Total</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, object>(row => row.LastUsed ?? DateTimeOffset.MinValue)">Last used</MudTableSortLabel></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Method">@context.Method</MudTd>
                            <MudTd DataLabel="Endpoint">@context.Endpoint</MudTd>
                            <MudTd DataLabel="Today">@context.Today</MudTd>
                            <MudTd DataLabel="Total">@context.Total</MudTd>
                            <MudTd DataLabel="Last used">@FormatDate(context.LastUsed)</MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText>No counters were returned for this area.</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
</MudStack>

@code {
    private UsageStatisticsCluster? statistics_;
    private readonly List<UsageRow> rows_ = [];
    private readonly List<UsageGroup> groups_ = [];
    private long totalCount_;
    private long todayCount_;
    private bool isLoading_ = true;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        isLoading_ = true;
        try
        {
            statistics_ = await Api.ClientCluster.GetClusterUsageStatisticsAsync();
            BuildRows();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Problem UsageStatistics initialization");
            statistics_ = null;
            rows_.Clear();
            groups_.Clear();
            totalCount_ = 0;
            todayCount_ = 0;
            Snackbar.Add("Unable to load Cluster usage statistics.", Severity.Error);
        }
        finally
        {
            isLoading_ = false;
        }
    }

    private void BuildRows()
    {
        rows_.Clear();
        groups_.Clear();
        totalCount_ = 0;
        todayCount_ = 0;

        if (statistics_ == null)
        {
            return;
        }

        foreach (var property in typeof(UsageStatisticsCluster).GetProperties(BindingFlags.Instance | BindingFlags.Public)
                     .Where(property => property.PropertyType == typeof(History) && property.Name.EndsWith("PerDay", StringComparison.Ordinal))
                     .OrderBy(property => ToEndpointDescriptor(property.Name).Area, StringComparer.Ordinal)
                     .ThenBy(property => ToEndpointDescriptor(property.Name).Endpoint, StringComparer.Ordinal)
                     .ThenBy(property => ToEndpointDescriptor(property.Name).Method, StringComparer.Ordinal))
        {
            if (property.GetValue(statistics_) is not History history)
            {
                continue;
            }

            EndpointDescriptor descriptor = ToEndpointDescriptor(property.Name);
            long total = Total(history);
            long today = Today(history);
            DateTimeOffset? lastUsed = LastUsed(history);

            totalCount_ += total;
            todayCount_ += today;
            rows_.Add(new UsageRow(descriptor.Area, descriptor.Endpoint, descriptor.Method, today, total, lastUsed));
        }

        groups_.AddRange(rows_
            .GroupBy(row => row.Area)
            .Select(group => new UsageGroup(
                group.Key,
                group.OrderBy(row => row.Endpoint, StringComparer.Ordinal)
                    .ThenBy(row => MethodSortOrder(row.Method))
                    .ToList(),
                group.Sum(row => row.Total),
                group.Sum(row => row.Today)))
            .OrderBy(group => group.Area, StringComparer.Ordinal));
    }

    private static long Total(History history) =>
        history.Data?.Where(entry => entry != null).Sum(entry => entry.Count) ?? 0;

    private static long Today(History history)
    {
        DateTimeOffset today = DateTimeOffset.UtcNow.Date;
        return history.Data?
            .Where(entry => entry != null && entry.Date.UtcDateTime.Date == today.Date)
            .Sum(entry => entry.Count) ?? 0;
    }

    private static DateTimeOffset? LastUsed(History history) =>
        history.Data?
            .Where(entry => entry != null && entry.Count > 0)
            .Select(entry => (DateTimeOffset?)entry.Date)
            .OrderByDescending(date => date)
            .FirstOrDefault();

    private static EndpointDescriptor ToEndpointDescriptor(string propertyName)
    {
        string name = propertyName.EndsWith("PerDay", StringComparison.Ordinal)
            ? propertyName[..^"PerDay".Length]
            : propertyName;

        string method = name switch
        {
            string value when value.StartsWith("Get", StringComparison.Ordinal) => "GET",
            string value when value.StartsWith("Post", StringComparison.Ordinal) => "POST",
            string value when value.StartsWith("Put", StringComparison.Ordinal) => "PUT",
            string value when value.StartsWith("Delete", StringComparison.Ordinal) => "DELETE",
            _ => "-"
        };

        string endpoint = SplitWords(RemoveMethodPrefix(name));
        return new EndpointDescriptor(GuessArea(endpoint), endpoint, method);
    }

    private static string RemoveMethodPrefix(string name)
    {
        foreach (string prefix in new[] { "GetAll", "Get", "Post", "Put", "Delete" })
        {
            if (name.StartsWith(prefix, StringComparison.Ordinal))
            {
                return name[prefix.Length..];
            }
        }

        return name;
    }

    private static string SplitWords(string value)
    {
        return string.Concat(value.Select((ch, index) =>
            index > 0 && char.IsUpper(ch) && !char.IsUpper(value[index - 1])
                ? " " + ch
                : ch.ToString()));
    }

    private static string GuessArea(string endpoint)
    {
        if (endpoint.Contains("Feature Category", StringComparison.OrdinalIgnoreCase))
        {
            return endpoint.Contains("Slot", StringComparison.OrdinalIgnoreCase)
                ? "Slot features"
                : "Cluster features";
        }
        if (endpoint.Contains("Identity", StringComparison.OrdinalIgnoreCase))
        {
            return "Cluster identities";
        }
        if (endpoint.Contains("Usage Statistics", StringComparison.OrdinalIgnoreCase))
        {
            return "Monitoring";
        }

        return "Clusters";
    }

    private static int MethodSortOrder(string method) => method switch
    {
        "GET" => 0,
        "POST" => 1,
        "PUT" => 2,
        "DELETE" => 3,
        _ => 4
    };

    private static string FormatDate(DateTimeOffset? value) =>
        value.HasValue && value.Value != default
            ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            : "-";

    private sealed record EndpointDescriptor(string Area, string Endpoint, string Method);
    private sealed record UsageRow(string Area, string Endpoint, string Method, long Today, long Total, DateTimeOffset? LastUsed);
    private sealed record UsageGroup(string Area, List<UsageRow> Rows, long Total, long Today)
    {
        public bool IsInitiallyExpanded => Total > 0;
    }
}
