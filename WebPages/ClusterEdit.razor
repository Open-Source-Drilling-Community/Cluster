    private static List<ClusterFeatureAssignment> CloneFeatureAssignments(IEnumerable<ClusterFeatureAssignment>? assignments)
    {
        return assignments?
            .Select(assignment => new ClusterFeatureAssignment
            {
                ID = assignment.ID == Guid.Empty ? Guid.NewGuid() : assignment.ID,
                FeatureCategoryID = assignment.FeatureCategoryID,
                FeatureOptionID = assignment.FeatureOptionID,
                FromDate = assignment.FromDate,
                ToDate = assignment.ToDate
            })
            .ToList() ?? [];
    }

    private static List<SlotFeatureAssignment> CloneSlotFeatureAssignments(IEnumerable<SlotFeatureAssignment>? assignments)
    {
        return assignments?
            .Select(assignment => new SlotFeatureAssignment
            {
                ID = assignment.ID == Guid.Empty ? Guid.NewGuid() : assignment.ID,
                FeatureCategoryID = assignment.FeatureCategoryID,
                FeatureOptionID = assignment.FeatureOptionID,
                FromDate = assignment.FromDate,
                ToDate = assignment.ToDate
            })
            .ToList() ?? [];
    }

    private static object BuildFeatureAssignmentDirtySnapshot(IEnumerable<ClusterFeatureAssignment> assignments)
    {
        return assignments
            .OrderBy(assignment => assignment.FeatureCategoryID)
            .ThenBy(assignment => assignment.FeatureOptionID)
            .ThenBy(assignment => assignment.ID)
            .Select(assignment => new
            {
                assignment.ID,
                assignment.FeatureCategoryID,
                assignment.FeatureOptionID,
                assignment.FromDate,
                assignment.ToDate
            }).ToList();
    }

    private static List<ClusterIdentityAssignment> CloneIdentityAssignments(IEnumerable<ClusterIdentityAssignment>? assignments)
    {
        return assignments?
            .Select(assignment => new ClusterIdentityAssignment
            {
                ID = assignment.ID == Guid.Empty ? Guid.NewGuid() : assignment.ID,
                IdentityID = assignment.IdentityID,
                Value = assignment.Value
            })
            .ToList() ?? [];
    }

    private static object BuildIdentityAssignmentDirtySnapshot(IEnumerable<ClusterIdentityAssignment> assignments)
    {
        return assignments
            .OrderBy(assignment => assignment.IdentityID)
            .ThenBy(assignment => assignment.ID)
            .Select(assignment => new
            {
                assignment.ID,
                assignment.IdentityID,
                assignment.Value
            })
            .ToList();
    }

    private bool HasUnsavedClusterChanges()
    {
        return cleanClusterSnapshot_ != null &&
            !string.Equals(cleanClusterSnapshot_, BuildClusterDirtySnapshot(), StringComparison.Ordinal);
    }

    private string BuildClusterDirtySnapshot()
    {
        Cluster cluster = BuildEditedCluster(CurrentCluster?.LastModificationDate);
        return System.Text.Json.JsonSerializer.Serialize(new
        {
            cluster.MetaInfo?.ID,
            cluster.Name,
            cluster.Description,
            cluster.FieldID,
            cluster.ReferencePoint,
            cluster.GroundMudLineDepth,
            cluster.TopWaterDepth,
            cluster.IsFixedPlatform,
            cluster.RigID,
            ClusterIdentityAssignments = BuildIdentityAssignmentDirtySnapshot(_clusterIdentityAssignments),
            ClusterFeatureAssignments = BuildFeatureAssignmentDirtySnapshot(_clusterFeatureAssignments),
            Slots = cluster.Slots?.OrderBy(slot => slot.Key).ToList()
        });
    }

    private void ApplyClusterToEditor(Cluster cluster)
    {
        _name = cluster.Name;
        _descr = cluster.Description;
        _field = Fields?.FirstOrDefault(f => f.MetaInfo != null && f.MetaInfo.ID == cluster.FieldID);
        IsFixedPlatform = cluster.IsFixedPlatform;
        _rig = null;
        _clusterIdentityAssignments = CloneIdentityAssignments(cluster.ClusterIdentityAssignments);
        _selectedIdentityAssignment = null;
        _selectedIdentityAssignmentId = null;
        _clusterFeatureAssignments = CloneFeatureAssignments(cluster.ClusterFeatureAssignments);
        _selectedFeatureAssignment = null;
        _selectedFeatureAssignmentId = null;
        if (cluster.RigID is not null && _rigs is not null)
        {
            foreach (var rig in _rigs)
            {
                if (rig is not null && rig.MetaInfo is not null && rig.MetaInfo.ID == cluster.RigID)
                {
                    _rig = rig;
                    break;
                }
            }
        }

        _referencePoint = CloneReferencePointForEditor(cluster.ReferencePoint);
        groundMudLineDepthWGS84 = cluster.GroundMudLineDepth?.GaussianValue?.Mean;
        groundMudLineDepthAccuracy = cluster.GroundMudLineDepth?.GaussianValue?.StandardDeviation;
        topWaterDepthWGS84 = cluster.TopWaterDepth?.GaussianValue?.Mean;
        topWaterDepthAccuracy = cluster.TopWaterDepth?.GaussianValue?.StandardDeviation;

        _slots ??= new List<SlotTemplate>();
        _slots.Clear();
        double maxAccuracyNorthing = double.MinValue;
        double maxAccuracyEasting = double.MinValue;
        if (cluster.Slots != null)
        {
            foreach (Slot slot in cluster.Slots.Values)
            {
                SlotTemplate slotTemplate = new()
                {
                    Name = slot.Name,
                    ID = slot.ID,
                    SlotFeatureAssignments = CloneSlotFeatureAssignments(slot.SlotFeatureAssignments)
                };
                if (slot.Latitude?.GaussianValue != null)
                {
                    slotTemplate.LatitudeWGS84 = slot.Latitude.GaussianValue.Mean;
                    if (slot.Latitude.GaussianValue.StandardDeviation != null &&
                        slot.Latitude.GaussianValue.StandardDeviation > maxAccuracyNorthing)
                    {
                        maxAccuracyNorthing = slot.Latitude.GaussianValue.StandardDeviation.Value;
                    }
                }

                if (slot.Longitude?.GaussianValue != null)
                {
                    slotTemplate.LongitudeWGS84 = slot.Longitude.GaussianValue.Mean;
                    if (slot.Longitude.GaussianValue.StandardDeviation != null &&
                        slot.Longitude.GaussianValue.StandardDeviation > maxAccuracyEasting)
                    {
                        maxAccuracyEasting = slot.Longitude.GaussianValue.StandardDeviation.Value;
                    }
                }
                _slots.Add(slotTemplate);
            }
        }
        ResetSelectedSlotFeatureAssignment();

        slotNorthingAccuracy = maxAccuracyNorthing > double.MinValue ? maxAccuracyNorthing * Api.EarthRadiusWGS84 : 0.01 * Api.EarthRadiusWGS84;
        slotEastingAccuracy = maxAccuracyEasting > double.MinValue ? maxAccuracyEasting * Api.EarthRadiusWGS84 : 0.01 * Api.EarthRadiusWGS84;
        UpdateSlotPlot();
        UpdateDepthPlot();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task DownloadJsonAsync<T>(T value, string fileName)
    {
        string json = System.Text.Json.JsonSerializer.Serialize(value, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true,
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
        string base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));
        string encodedFileName = System.Text.Json.JsonEncodedText.Encode(fileName).ToString();
        string script =
            "(() => {" +
            $"const binary = atob(\"{base64}\");" +
            "const bytes = new Uint8Array(binary.length);" +
            "for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);" +
            "const blob = new Blob([bytes], { type: \"application/json;charset=utf-8\" });" +
            "const url = URL.createObjectURL(blob);" +
            "const anchor = document.createElement(\"a\");" +
            "anchor.href = url;" +
            $"anchor.download = \"{encodedFileName}\";" +
            "document.body.appendChild(anchor);" +
            "anchor.click();" +
            "anchor.remove();" +
            "URL.revokeObjectURL(url);" +
            "})()";
        await JSRuntime.InvokeVoidAsync("eval", script);
    }

    private static string SanitizeFileName(string fileName)
    {
        char[] invalidChars = System.IO.Path.GetInvalidFileNameChars();
        string sanitized = new(fileName.Select(character => invalidChars.Contains(character) ? '_' : character).ToArray());
        return string.IsNullOrWhiteSpace(sanitized) ? "cluster.json" : sanitized;
    }

