    private Cluster BuildEditedCluster(DateTimeOffset? lastModificationDate)
    {
        Cluster cluster = new()
        {
            MetaInfo = CurrentCluster?.MetaInfo,
            Name = _name,
            Description = _descr,
            CreationDate = CurrentCluster?.CreationDate,
            LastModificationDate = lastModificationDate,
            FieldID = (_field != null && _field.MetaInfo != null) ? _field.MetaInfo.ID : null,
            ClusterIdentityAssignments = CloneIdentityAssignments(_clusterIdentityAssignments),
            ClusterFeatureAssignments = CloneFeatureAssignments(_clusterFeatureAssignments),
            ReferencePoint = CloneReferencePointForStorage(_referencePoint),
            GroundMudLineDepth = (groundMudLineDepthWGS84 != null) ? new GaussianDrillingProperty()
            {
                GaussianValue = new GaussianDistribution()
                {
                    Mean = groundMudLineDepthWGS84,
                    StandardDeviation = (groundMudLineDepthAccuracy == null) ? 0.01 : groundMudLineDepthAccuracy
                },
            } : null,
            TopWaterDepth = (topWaterDepthWGS84 != null) ? new GaussianDrillingProperty()
            {
                GaussianValue = new GaussianDistribution()
                {
                    Mean = topWaterDepthWGS84,
                    StandardDeviation = (topWaterDepthAccuracy == null) ? 0.01 : topWaterDepthAccuracy
                },
            } : null,
            IsFixedPlatform = _isFixedPlatform,
            RigID = _isFixedPlatform ? ((_rig != null && _rig.MetaInfo != null) ? _rig.MetaInfo.ID : null) : null
        };

        if (_slots != null)
        {
            cluster.Slots = new Dictionary<string, Slot>();
            double latitudeAccuracy = slotNorthingAccuracy == null ? 0.01 / Api.EarthRadiusWGS84 : slotNorthingAccuracy.Value / Api.EarthRadiusWGS84;
            double longitudeAccuracy = slotEastingAccuracy == null ? 0.01 / Api.EarthRadiusWGS84 : slotEastingAccuracy.Value / Api.EarthRadiusWGS84;
            foreach (SlotTemplate slotTemplate in _slots)
            {
                if (slotTemplate != null && slotTemplate.ID != Guid.Empty)
                {
                    Slot slot = new()
                    {
                        Name = slotTemplate.Name,
                        ID = slotTemplate.ID,
                        Latitude = (slotTemplate.LatitudeWGS84 != null) ? new GaussianDrillingProperty() { GaussianValue = new GaussianDistribution() { Mean = slotTemplate.LatitudeWGS84, StandardDeviation = latitudeAccuracy } } : null,
                        Longitude = (slotTemplate.LongitudeWGS84 != null) ? new GaussianDrillingProperty() { GaussianValue = new GaussianDistribution() { Mean = slotTemplate.LongitudeWGS84, StandardDeviation = longitudeAccuracy } } : null,
                        SlotFeatureAssignments = CloneSlotFeatureAssignments(slotTemplate.SlotFeatureAssignments)
                    };
                    cluster.Slots.Add(slot.ID.ToString(), slot);
                }
            }
        }

        return cluster;
    }

    private static MathPoint3DGlobalCoordinates CloneReferencePointForEditor(DtoPoint3DGlobalCoordinates? point)
    {
        MathPoint3DGlobalCoordinates editorPoint = new();
        if (point == null)
        {
            return editorPoint;
        }

        if (point.RiemannianNorth != null || point.RiemannianEast != null)
        {
            editorPoint.RiemannianNorth = point.RiemannianNorth;
            editorPoint.RiemannianEast = point.RiemannianEast;
        }
        else
        {
            editorPoint.Latitude = point.Latitude;
            editorPoint.Longitude = point.Longitude;
        }

        editorPoint.TVD = point.TVD;
        editorPoint.Z = point.Z;
        return editorPoint;
    }

    private static DtoPoint3DGlobalCoordinates? CloneReferencePointForStorage(MathPoint3DGlobalCoordinates point)
    {
        return IsEmptyReferencePoint(point)
            ? null
            : new DtoPoint3DGlobalCoordinates
            {
                RiemannianNorth = point.RiemannianNorth,
                RiemannianEast = point.RiemannianEast,
                Latitude = point.Latitude,
                Longitude = point.Longitude,
                X = point.RiemannianNorth,
                Y = point.RiemannianEast,
                TVD = point.TVD,
                Z = point.Z
            };
    }

    private static bool IsEmptyReferencePoint(MathPoint3DGlobalCoordinates point)
    {
        return point.RiemannianNorth == null &&
            point.RiemannianEast == null &&
            point.Latitude == null &&
            point.Longitude == null &&
            point.TVD == null &&
            point.Z == null;
    }

