        }

        ClusterIdentity? identity = FindClusterIdentity(identityId);
        return identity != null && !IsIdentityAssigned(identity);
    }

    private void AssignSelectedIdentity()
    {
        if (!CanAssignSelectedIdentity())
        {
            return;
        }

        _clusterIdentityAssignments.Add(new ClusterIdentityAssignment
        {
            ID = Guid.NewGuid(),
            IdentityID = _selectedIdentityId
        });
    }

    private void UnassignSelectedIdentity()
    {
        if (_selectedIdentityAssignmentId is not Guid assignmentId)
        {
            return;
        }

        ClusterIdentityAssignment? assignment = _clusterIdentityAssignments.FirstOrDefault(item => item.ID == assignmentId);
        if (assignment != null)
        {
            _clusterIdentityAssignments.Remove(assignment);
        }
        _selectedIdentityAssignment = null;
        _selectedIdentityAssignmentId = null;
    }

    private void SetSelectedIdentityAssignment(ClusterIdentityAssignment? assignment)
    {
        _selectedIdentityAssignment = assignment;
        _selectedIdentityAssignmentId = assignment?.ID;
    }

    private string GetIdentityAssignmentDisplayName(ClusterIdentityAssignment assignment)
    {
        return assignment.IdentityID is Guid identityId
            ? FindClusterIdentity(identityId)?.Name ?? "Unknown identity"
            : "Unknown identity";
    }

    private ClusterIdentity? FindClusterIdentity(Guid identityId)
    {
        return _clusterIdentities.FirstOrDefault(identity => identity.MetaInfo?.ID == identityId);
    }

    private bool TryValidateIdentityAssignments()
    {
        foreach (ClusterIdentityAssignment assignment in _clusterIdentityAssignments)
        {
            if (assignment.IdentityID is not Guid identityId)
            {
                Snackbar.Add("Identity assignments must have an identity", Severity.Warning);
                return false;
            }

            if (FindClusterIdentity(identityId) == null)
            {
                Snackbar.Add("Identity assignments must reference existing identities", Severity.Warning);
                return false;
            }

            if (string.IsNullOrWhiteSpace(assignment.Value))
            {
                Snackbar.Add("Identity assignment values cannot be empty", Severity.Warning);
                return false;
            }
        }

        if (_clusterIdentityAssignments
            .Where(assignment => assignment.IdentityID != null)
            .GroupBy(assignment => assignment.IdentityID)
            .Any(group => group.Count() > 1))
        {
            Snackbar.Add("Each cluster identity can only be assigned once", Severity.Warning);
            return false;
        }

        return true;
    }

    //Quick filter - filter gobally across multiple columns with the same input
    private Func<Slot, bool> _slotFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_slotSearchString))
            return true;
        if ($"{x.Name}".Contains(_slotSearchString))
            return true;

        return false;
    };

