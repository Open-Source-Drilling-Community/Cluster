    private async Task ImportClusterAsync(InputFileChangeEventArgs args)
    {
        if (CurrentCluster?.MetaInfo == null)
        {
            Snackbar.Add("No current cluster is available for import", Severity.Warning);
            return;
        }

        try
        {
            using System.IO.Stream stream = args.File.OpenReadStream(128 * 1024 * 1024);
            Cluster? imported = await System.Text.Json.JsonSerializer.DeserializeAsync<Cluster>(
                stream,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (imported == null)
            {
                Snackbar.Add("The selected file does not contain a cluster", Severity.Warning);
                return;
            }

            ApplyClusterToEditor(imported);
            _ = RefreshReferenceSourcesAsync();
            Snackbar.Add("Imported cluster into the editor. Save to persist the changes.", Severity.Success);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Problem importing the Cluster");
            Snackbar.Add("Error importing cluster: " + ex.Message, Severity.Error);
        }
    }

