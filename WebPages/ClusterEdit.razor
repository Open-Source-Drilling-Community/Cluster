    private async Task RefreshReferenceSourcesAsync()
    {
        if (isRefreshingReferenceSources_)
        {
            hasPendingReferenceSourceRefresh_ = true;
            return;
        }

        try
        {
            isRefreshingReferenceSources_ = true;
            Cluster cluster = BuildEditedCluster(CurrentCluster?.LastModificationDate);
            DataUtils.ApplyClusterReferenceValues(cluster);
            DataUtils.UnitAndReferenceParameters.MeanSeaLevelDepthReferenceSource.MeanSeaLevelDepthReference =
                await MslDepthReferenceUtils.ResolveMeanSeaLevelDepthReferenceAsync(Api, cluster);
            UpdateDepthPlot();
            ManageReferenceNorthingEasting();

            ReferencePositionSample? fieldReference = await TryLoadFieldReferenceSampleAsync(_field?.MetaInfo?.ID);
            UpdateFieldPositionReferenceSource(fieldReference);

            ReferencePositionSample? conversionReference = fieldReference ?? TryBuildClusterReferenceSample();
            await RefreshCartographicAndGeodeticReferenceSourcesAsync(conversionReference);
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Unable to update cluster editor unit and reference sources");
            ClearCartographicAndGeodeticReferenceSources();
        }
        finally
        {
            isRefreshingReferenceSources_ = false;
            await InvokeAsync(StateHasChanged);
            if (hasPendingReferenceSourceRefresh_)
            {
                hasPendingReferenceSourceRefresh_ = false;
                _ = RefreshReferenceSourcesAsync();
            }
        }
    }

    private ReferencePositionSample? TryBuildClusterReferenceSample()
    {
        return referenceLatitudeWGS84 == null || referenceLongitudeWGS84 == null
            ? null
            : new ReferencePositionSample(referenceNorthing, referenceEasting, referenceLatitudeWGS84.Value, referenceLongitudeWGS84.Value);
    }

    private async Task<ReferencePositionSample?> TryLoadFieldReferenceSampleAsync(Guid? fieldId)
    {
        if (fieldId == null || fieldId == Guid.Empty)
        {
            return null;
        }

        try
        {
            Field field = await Api.ClientField.GetFieldByIdAsync(fieldId.Value);
            Point3DGlobalCoordinates? referencePoint = field.ReferencePoint;
            if (referencePoint == null)
            {
                return null;
            }

            return new ReferencePositionSample(
                referencePoint.RiemannianNorth,
                referencePoint.RiemannianEast,
                referencePoint.Latitude,
                referencePoint.Longitude);
        }
        catch (Exception ex)
        {
            logger.LogDebug(ex, "Unable to load field reference point for field {FieldId}", fieldId);
            return null;
        }
    }

    private static void UpdateFieldPositionReferenceSource(ReferencePositionSample? sample)
    {
        DataUtils.UnitAndReferenceParameters.FieldPositionReferenceSource.FieldNorthPositionReference = -sample?.RiemannianNorth;
        DataUtils.UnitAndReferenceParameters.FieldPositionReferenceSource.FieldEastPositionReference = -sample?.RiemannianEast;
    }

    private async Task RefreshCartographicAndGeodeticReferenceSourcesAsync(ReferencePositionSample? sample)
    {
        if (sample?.Latitude == null || sample.Value.Longitude == null || _field?.MetaInfo?.ID == null || _field.MetaInfo.ID == Guid.Empty)
        {
            ClearCartographicAndGeodeticReferenceSources();
            return;
        }

        ReferencePositionSample referenceSample = sample.Value;
        FieldCoordinateConversionPositionResult? coordinate = await ConvertReferenceSampleToCartographicAsync(_field.MetaInfo.ID, referenceSample);
        if (coordinate == null)
        {
            ClearCartographicAndGeodeticReferenceSources();
            return;
        }

        DataUtils.UnitAndReferenceParameters.CartographicProjectionDatumGeodeticReferenceSource.CartographicProjectionDatumLatitudeReference =
            coordinate.ProjectionDatumGeographicCoordinate.Latitude - referenceSample.Latitude!.Value;
        DataUtils.UnitAndReferenceParameters.CartographicProjectionDatumGeodeticReferenceSource.CartographicProjectionDatumLongitudeReference =
            coordinate.ProjectionDatumGeographicCoordinate.Longitude - referenceSample.Longitude!.Value;

        DataUtils.UnitAndReferenceParameters.CartographicGridPositionReferenceSource.CartographicGridNorthPositionReference =
            referenceSample.RiemannianNorth == null ? null : coordinate.ProjectedCoordinate.Northing - referenceSample.RiemannianNorth.Value;
        DataUtils.UnitAndReferenceParameters.CartographicGridPositionReferenceSource.CartographicGridEastPositionReference =
            referenceSample.RiemannianEast == null ? null : coordinate.ProjectedCoordinate.Easting - referenceSample.RiemannianEast.Value;
    }

    private async Task<FieldCoordinateConversionPositionResult?> ConvertReferenceSampleToCartographicAsync(Guid fieldId, ReferencePositionSample sample)
    {
        FieldForwardConversionRequest request = new()
        {
            FieldID = fieldId,
            SourceGeographicReference = FieldGeographicReference.Wgs84,
            ProjectionApplicabilityPolicy = FieldApplicabilityPolicy.AllowUnknown,
            Transformation = CreateTransformationOptions(),
            Positions =
            [
                new FieldForwardConversionPosition
                {
                    Latitude = sample.Latitude!.Value,
                    Longitude = sample.Longitude!.Value,
                    VerticalDepth = referenceDepthWGS84 ?? 0
                }
            ]
        };
        FieldCoordinateConversionResponse response = await Api.ClientField.ForwardFieldCoordinatesAsync(request);
        return response.Positions?.FirstOrDefault();
    }

    private static FieldTransformationOptions CreateTransformationOptions() => new()
    {
        SelectionPolicy = FieldTransformationSelectionPolicy.FirstAvailable,
        ApplicabilityPolicy = FieldApplicabilityPolicy.AllowUnknown,
        DepthPolicy = FieldDepthTransformationPolicy.AllowUntransformedDepthFor2D
    };

    private static void ClearCartographicAndGeodeticReferenceSources()
    {
        DataUtils.UnitAndReferenceParameters.CartographicGridPositionReferenceSource.CartographicGridNorthPositionReference = null;
        DataUtils.UnitAndReferenceParameters.CartographicGridPositionReferenceSource.CartographicGridEastPositionReference = null;
        DataUtils.UnitAndReferenceParameters.CartographicProjectionDatumGeodeticReferenceSource.CartographicProjectionDatumLatitudeReference = null;
        DataUtils.UnitAndReferenceParameters.CartographicProjectionDatumGeodeticReferenceSource.CartographicProjectionDatumLongitudeReference = null;
    }

