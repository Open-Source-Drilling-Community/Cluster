    private async Task Save()
    {
        try
        {
            if (CurrentCluster != null && CurrentCluster.MetaInfo != null)
            {
                if (!TryValidateIdentityAssignments() || !TryValidateFeatureAssignments() || !TryValidateSlotFeatureAssignments())
                {
                    return;
                }

                Cluster cluster = BuildEditedCluster(DateTimeOffset.UtcNow);
                await Api.ClientCluster.PutClusterByIdAsync(CurrentCluster.MetaInfo.ID, cluster);
                CurrentCluster = await Api.ClientCluster.GetClusterByIdAsync(CurrentCluster.MetaInfo.ID);
                ApplyClusterToEditor(CurrentCluster);
                await RefreshReferenceSourcesAsync();
                MarkClusterClean();
                logger.LogInformation("Saved the Cluster successfully");
                Snackbar.Add("Saved the Cluster successfully", Severity.Success);
            }
            else
            {
                logger.LogWarning("Problem while saving the Cluster");
                Snackbar.Add("Problem while saving the Cluster", Severity.Warning);
            }
        }
        catch (ApiException ex)
        {
            logger.LogError(ex, "Problem while saving the Cluster");
            Snackbar.Add("Problem while saving the Cluster", Severity.Warning);
        }
        UpdateSlotPlot();
    }

