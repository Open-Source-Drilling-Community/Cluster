            UpdateDepthPlot();
        }
    }
    private void ChangeReferenceDepthDatum(double? val)
    {
        referenceDepthDatum = val;
        if (referenceLatitudeDatum != null && referenceLongitudeDatum != null && referenceDepthDatum != null)
        {
            _ = CalculateReferenceDatumAsync();
            UpdateDepthPlot();
        }
        else if (referenceNorthing != null && referenceEasting != null && referenceDepthDatum != null)
        {
            _ = CalculateReferenceCartographyAsync();
            UpdateDepthPlot();
        }
    }

    private async Task CalculateReferenceWgs84Async()
    {
        if (referenceLatitudeWGS84 == null || referenceLongitudeWGS84 == null || referenceDepthWGS84 == null ||
            _field?.MetaInfo?.ID is not Guid fieldId || fieldId == Guid.Empty)
        {
            return;
        }

        try
        {
            FieldCoordinateConversionPositionResult? result = await ForwardFieldCoordinateAsync(
                fieldId, FieldGeographicReference.Wgs84,
                referenceLatitudeWGS84.Value, referenceLongitudeWGS84.Value, referenceDepthWGS84.Value);
            if (result == null) return;
            referenceLatitudeDatum = result.ProjectionDatumGeographicCoordinate.Latitude;
            referenceLongitudeDatum = result.ProjectionDatumGeographicCoordinate.Longitude;
            referenceDepthDatum = result.ProjectionDatumVerticalDepth;
            referenceNorthing = result.ProjectedCoordinate.Northing;
            referenceEasting = result.ProjectedCoordinate.Easting;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Unable to convert the Cluster reference from WGS 84");
        }
    }

    private async Task CalculateReferenceDatumAsync()
    {
        if (referenceLatitudeDatum == null || referenceLongitudeDatum == null || referenceDepthDatum == null ||
            _field?.MetaInfo?.ID is not Guid fieldId || fieldId == Guid.Empty)
        {
            return;
        }

        try
        {
            FieldCoordinateConversionPositionResult? result = await ForwardFieldCoordinateAsync(
                fieldId, FieldGeographicReference.ProjectionDatum,
                referenceLatitudeDatum.Value, referenceLongitudeDatum.Value, referenceDepthDatum.Value);
            if (result == null) return;
            referenceLatitudeWGS84 = result.Wgs84GeographicCoordinate?.Latitude;
            referenceLongitudeWGS84 = result.Wgs84GeographicCoordinate?.Longitude;
            referenceDepthWGS84 = result.Wgs84VerticalDepth;
            referenceNorthing = result.ProjectedCoordinate.Northing;
            referenceEasting = result.ProjectedCoordinate.Easting;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Unable to convert the Cluster reference from the projection datum");
        }
    }

    private async Task CalculateReferenceCartographyAsync()
    {
        if (referenceNorthing == null || referenceEasting == null || referenceDepthDatum == null ||
            _field?.MetaInfo?.ID is not Guid fieldId || fieldId == Guid.Empty)
        {
            return;
        }

        try
        {
            FieldInverseConversionRequest request = new()
            {
                FieldID = fieldId,
                ProjectionApplicabilityPolicy = FieldApplicabilityPolicy.AllowUnknown,
                Transformation = CreateTransformationOptions(),
                Positions =
                [
                    new FieldInverseConversionPosition
                    {
                        Northing = referenceNorthing.Value,
                        Easting = referenceEasting.Value,
                        VerticalDepth = referenceDepthDatum.Value
                    }
                ]
            };
            FieldCoordinateConversionResponse response = await Api.ClientField.InverseFieldCoordinatesAsync(request);
            FieldCoordinateConversionPositionResult? result = response.Positions?.FirstOrDefault();
            if (result == null) return;
            referenceLatitudeDatum = result.ProjectionDatumGeographicCoordinate.Latitude;
            referenceLongitudeDatum = result.ProjectionDatumGeographicCoordinate.Longitude;
            referenceDepthDatum = result.ProjectionDatumVerticalDepth;
            referenceLatitudeWGS84 = result.Wgs84GeographicCoordinate?.Latitude;
            referenceLongitudeWGS84 = result.Wgs84GeographicCoordinate?.Longitude;
            referenceDepthWGS84 = result.Wgs84VerticalDepth;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Unable to convert the Cluster reference from projected coordinates");
        }
    }

    private async Task<FieldCoordinateConversionPositionResult?> ForwardFieldCoordinateAsync(
        Guid fieldId, FieldGeographicReference source, double latitude, double longitude, double verticalDepth)
    {
        FieldForwardConversionRequest request = new()
        {
            FieldID = fieldId,
            SourceGeographicReference = source,
            ProjectionApplicabilityPolicy = FieldApplicabilityPolicy.AllowUnknown,
            Transformation = CreateTransformationOptions(),
            Positions =
            [
                new FieldForwardConversionPosition
                {
                    Latitude = latitude,
                    Longitude = longitude,
                    VerticalDepth = verticalDepth
                }
            ]
        };
        FieldCoordinateConversionResponse response = await Api.ClientField.ForwardFieldCoordinatesAsync(request);
        return response.Positions?.FirstOrDefault();
    }
