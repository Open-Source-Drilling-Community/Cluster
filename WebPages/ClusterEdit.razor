    {
        if (CurrentCluster?.MetaInfo == null)
        {
            Snackbar.Add("No cluster is available for export", Severity.Warning);
            return;
        }

        Cluster cluster = BuildEditedCluster(CurrentCluster.LastModificationDate);
        await DownloadJsonAsync(cluster, SanitizeFileName($"{_name ?? "cluster"}.json"));
        Snackbar.Add("Exported cluster", Severity.Success);
