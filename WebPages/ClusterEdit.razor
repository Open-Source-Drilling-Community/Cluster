    private bool TryValidateSlotFeatureAssignments()
    {
        foreach (SlotTemplate slot in _slots)
        {
            foreach (SlotFeatureAssignment assignment in slot.SlotFeatureAssignments)
            {
                if (assignment.FeatureCategoryID is not Guid categoryId || assignment.FeatureOptionID is not Guid optionId)
                {
                    Snackbar.Add($"Slot '{GetSlotDisplayName(slot)}' has a feature assignment without a category or option", Severity.Warning);
                    return false;
                }

                SlotFeatureCategory? category = FindSlotFeatureCategory(categoryId);
                if (category == null || !SlotFeatureCategoryContainsOption(category, optionId))
                {
                    Snackbar.Add($"Slot '{GetSlotDisplayName(slot)}' has a feature assignment that references an unknown category or option", Severity.Warning);
                    return false;
                }

                if (!category.HasValidityPeriod)
                {
                    assignment.FromDate = null;
                    assignment.ToDate = null;
                }

                if (assignment.FromDate != null && assignment.ToDate != null && assignment.FromDate > assignment.ToDate)
                {
                    Snackbar.Add($"Slot '{GetSlotDisplayName(slot)}' has a feature From date after the To date", Severity.Warning);
                    return false;
                }
            }

            foreach (SlotFeatureCategory category in _slotFeatureCategories.Where(category => category.IsExclusive))
            {
                if (category.MetaInfo?.ID is not Guid categoryId)
                {
                    continue;
                }

                List<SlotFeatureAssignment> categoryAssignments = slot.SlotFeatureAssignments
                    .Where(assignment => assignment.FeatureCategoryID == categoryId)
                    .ToList();

                if (!category.HasValidityPeriod && categoryAssignments.Count > 1)
                {
                    Snackbar.Add($"Only one option can be assigned for '{category.Name}' on slot '{GetSlotDisplayName(slot)}'", Severity.Warning);
                    return false;
                }

                if (category.HasValidityPeriod && HasOverlappingSlotFeatureAssignments(categoryAssignments))
                {
                    Snackbar.Add($"Slot feature assignment periods cannot overlap for '{category.Name}' on slot '{GetSlotDisplayName(slot)}'", Severity.Warning);
                    return false;
                }
            }
        }

        return true;
    }

    private static bool HasOverlappingSlotFeatureAssignments(List<SlotFeatureAssignment> assignments)
    {
        for (int i = 0; i < assignments.Count; i++)
        {
            for (int j = i + 1; j < assignments.Count; j++)
            {
                if (SlotFeatureIntervalsOverlap(assignments[i], assignments[j]))
                {
                    return true;
                }
            }
        }

        return false;
    }

    private static bool SlotFeatureIntervalsOverlap(SlotFeatureAssignment first, SlotFeatureAssignment second)
    {
        DateTimeOffset firstStart = first.FromDate ?? DateTimeOffset.MinValue;
        DateTimeOffset firstEnd = first.ToDate ?? DateTimeOffset.MaxValue;
        DateTimeOffset secondStart = second.FromDate ?? DateTimeOffset.MinValue;
        DateTimeOffset secondEnd = second.ToDate ?? DateTimeOffset.MaxValue;
        return firstStart <= secondEnd && secondStart <= firstEnd;
    }

