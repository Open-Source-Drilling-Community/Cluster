@implements IUnitAwareComponent
@inject ILogger<ClusterEdit> logger
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IClusterAPIUtils Api
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json
@using MathPoint3DGlobalCoordinates = OSDC.DotnetLibraries.General.Math.Point3DGlobalCoordinates
@using DtoPoint3DGlobalCoordinates = OSDC.Drilling.Cluster.ModelShared.Point3DGlobalCoordinates

<MudUnitAndReferenceChoiceTag HttpHost="@Api.HostNameUnitConversion"
                              HttpBasePath="@Api.HostBasePathUnitConversion"
                              HttpController="UnitSystem/"
                              UnitSystemName="@DataUtils.UnitAndReferenceParameters.UnitSystemName"
                              UnitSystemNameChanged="@DataUtils.UpdateUnitSystemName"
                              DepthReferenceName="@DataUtils.UnitAndReferenceParameters.DepthReferenceName"
                              DepthReferenceNameChanged="@DataUtils.UpdateDepthReferenceName"
                              GroundMudLineDepthReferenceSource="@DataUtils.UnitAndReferenceParameters.GroundMudLineDepthReferenceSource"
                              MeanSeaLevelDepthReferenceSource="@DataUtils.UnitAndReferenceParameters.MeanSeaLevelDepthReferenceSource"
                              PositionReferenceName="@DataUtils.UnitAndReferenceParameters.PositionReferenceName"
                              PositionReferenceNameChanged="@DataUtils.UpdatePositionReferenceName"
                              GeodeticReferenceName="@DataUtils.UnitAndReferenceParameters.GeodeticReferenceName"
                              GeodeticReferenceNameChanged="@DataUtils.UpdateGeodeticReferenceName"
                              FieldPositionReferenceSource="@DataUtils.UnitAndReferenceParameters.FieldPositionReferenceSource"
                              ClusterPositionReferenceSource="@DataUtils.UnitAndReferenceParameters.ClusterPositionReferenceSource"
                              CartographicGridPositionReferenceSource="@DataUtils.UnitAndReferenceParameters.CartographicGridPositionReferenceSource"
                              CartographicProjectionDatumGeodeticReferenceSource="@DataUtils.UnitAndReferenceParameters.CartographicProjectionDatumGeodeticReferenceSource">
    <MudText Class="mt-4 mb-4" Typo="Typo.h6">Edit Cluster</MudText>
    <MudContainer Class="d-flex flex-row mt-4 mb-4">
    <MudButton Class="me-1" Variant="Variant.Filled" Color="Color.Success" OnClick="Save">Save</MudButton>
    <MudButton Class="me-1" Variant="Variant.Filled" Color="Color.Error" OnClick="CloseEditorAsync">Close</MudButton>
    <MudButton Class="me-1" Variant="Variant.Filled" Color="Color.Primary" OnClick="ExportClusterAsync">Export</MudButton>
    <label class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-filled-size-medium">
        Import
        <InputFile OnChange="ImportClusterAsync" style="display:none" />
    </label>
    </MudContainer>

    <MudExpansionPanels Class="mt-4 mb-4">
    <MudExpansionPanel Text="Description" Expanded="true">
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="@_name" Label="Name" Required="true" ShrinkLabel />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="@_descr" Label="Description" ShrinkLabel />
            </MudItem>
            @if (Fields != null && Fields.Count > 0)
            {
                <MudItem xs="12" md="3">
                    <MudSelect T="FieldLight" Value="@_field" ValueChanged="@SetField" Label="Field" ShrinkLabel ToStringFunc="@(s => s?.Name)">
                        @foreach (var f in Fields)
                        {
                            <MudSelectItem T="FieldLight" Value="@f">@f.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" md="3">
                <MudSwitch T="bool" @bind-Value="IsFixedPlatform" Label="Fixed Platform" Color="Color.Primary" />
            </MudItem>
            @if (IsFixedPlatform)
            {
                @if (_rigs == null || !_rigs.Any())
                {
                    <MudItem xs="12" md="6">
                        <MudText Color="Color.Warning">No rigs loaded. Check configuration or click Reload.</MudText>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadRigs">Reload rigs</MudButton>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" md="3">
                        <MudSelect T="RigLight" @bind-Value="_rig" Label="Rig" ShrinkLabel ToStringFunc="@(r => GetRigName(r))">
                            @foreach (var rig in _rigs)
                            {
                                @if (rig is not null && rig.MetaInfo is not null && !string.IsNullOrEmpty(rig.Name))
                                {
                                    <MudSelectItem Value="rig">@rig.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>
                }
            }
        </MudGrid>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Reference">
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudInputWithUnitAdornment QuantityName="PositionDrilling"
                                           QuantityLabel="Reference North"
                                           DrillingSignalReference="@DrillingSignalReferenceType.Position"
                                           PositionDirection="@PositionDirectionType.North"
                                           SIValueNullable="@_referencePoint.RiemannianNorth"
                                           SIValueNullableChanged="@SetReferenceNorth"
                                           Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudInputWithUnitAdornment QuantityName="PositionDrilling"
                                           QuantityLabel="Reference East"
                                           DrillingSignalReference="@DrillingSignalReferenceType.Position"
                                           PositionDirection="@PositionDirectionType.East"
                                           SIValueNullable="@_referencePoint.RiemannianEast"
                                           SIValueNullableChanged="@SetReferenceEast"
                                           Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudInputWithUnitAdornment QuantityName="PlaneAngleGeodesic"
                                           QuantityLabel="Reference Latitude"
                                           DrillingSignalReference="@DrillingSignalReferenceType.Geodetic"
                                           PositionDirection="@PositionDirectionType.North"
                                           SIValueNullable="@_referencePoint.Latitude"
                                           SIValueNullableChanged="@SetReferenceLatitude"
                                           Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudInputWithUnitAdornment QuantityName="PlaneAngleGeodesic"
                                           QuantityLabel="Reference Longitude"
                                           DrillingSignalReference="@DrillingSignalReferenceType.Geodetic"
                                           PositionDirection="@PositionDirectionType.East"
                                           SIValueNullable="@_referencePoint.Longitude"
                                           SIValueNullableChanged="@SetReferenceLongitude"
                                           Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudInputWithUnitAdornment QuantityName="DepthDrilling"
                                           QuantityLabel="Reference Depth"
                                           DrillingSignalReference="@DrillingSignalReferenceType.Depth"
                                           SIValueNullable="@_referencePoint.TVD"
                                           SIValueNullableChanged="@SetReferenceDepth"
                                           Immediate="true" />
            </MudItem>
        </MudGrid>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Identities">
        @if (_clusterIdentities.Count > 0)
        {
            <MudGrid Class="mt-2">
                <MudItem xs="12" md="5">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Available</MudText>
                    @foreach (ClusterIdentity identity in _clusterIdentities)
                    {
                        <MudButton Class="me-1 mb-1" Variant="@GetIdentityButtonVariant(identity)" Color="@GetIdentityButtonColor(identity)" Size="Size.Small" Disabled="@IsIdentityAssigned(identity)" OnClick="@(() => SelectClusterIdentity(identity))">
                            @GetIdentityDisplayName(identity)
                        </MudButton>
                    }
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex flex-column justify-center">
                    <MudButton Class="mb-2" Variant="Variant.Filled" Color="Color.Success" Disabled="@(!CanAssignSelectedIdentity())" OnClick="AssignSelectedIdentity">Assign</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(!_selectedIdentityAssignmentId.HasValue)" OnClick="UnassignSelectedIdentity">Unassign</MudButton>
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Selected</MudText>
                    <MudDataGrid T="ClusterIdentityAssignment" Items="@_clusterIdentityAssignments" SelectedItem="@_selectedIdentityAssignment" SelectedItemChanged="SetSelectedIdentityAssignment" Hover="true" Dense="true" Elevation="0">
                        <Columns>
                            <PropertyColumn Property="x => GetIdentityAssignmentDisplayName(x)" Title="Name" Editable="false" />
                            <TemplateColumn Title="Value">
                                <CellTemplate>
                                    <MudTextField @bind-Value="context.Item.Value" Required="true" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                </MudItem>
            </MudGrid>
        }
    </MudExpansionPanel>
    <MudExpansionPanel Text="Features">
        @if (_clusterFeatureCategories.Count > 0)
        {
            <MudGrid Class="mt-2">
                <MudItem xs="12" md="5">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Available</MudText>
                    <MudExpansionPanels MultiExpansion="true">
                        @foreach (ClusterFeatureCategory category in _clusterFeatureCategories)
                        {
                            <MudExpansionPanel Text="@GetCategoryDisplayName(category)">
                                @foreach (ClusterFeatureOption option in category.Options ?? [])
                                {
                                    <MudButton Class="me-1 mb-1" Variant="@GetOptionButtonVariant(category, option)" Color="@GetOptionButtonColor(category, option)" Size="Size.Small" Disabled="@IsOptionUnavailable(category)" OnClick="@(() => SelectFeatureOption(category, option))">
                                        @option.Name
                                    </MudButton>
                                }
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex flex-column justify-center">
                    <MudButton Class="mb-2" Variant="Variant.Filled" Color="Color.Success" Disabled="@(!CanAssignSelectedOption())" OnClick="AssignSelectedOption">Assign</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(!_selectedFeatureAssignmentId.HasValue)" OnClick="UnassignSelectedFeature">Unassign</MudButton>
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Selected</MudText>
                    <MudDataGrid T="ClusterFeatureAssignment" Items="@_clusterFeatureAssignments" SelectedItem="@_selectedFeatureAssignment" SelectedItemChanged="SetSelectedFeatureAssignment" Hover="true" Dense="true" Elevation="0">
                        <Columns>
                            <PropertyColumn Property="x => GetAssignmentDisplayName(x)" Title="Name" Editable="false" />
                            <TemplateColumn Title="From">
                                <CellTemplate>
                                    <MudDatePicker Date="@ToDateTime(context.Item.FromDate)" DateChanged="@((DateTime? value) => SetAssignmentFromDate(context.Item, value))" Clearable="true" Disabled="@(!CategoryHasValidityPeriod(context.Item))" />
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="To">
                                <CellTemplate>
                                    <MudDatePicker Date="@ToDateTime(context.Item.ToDate)" DateChanged="@((DateTime? value) => SetAssignmentToDate(context.Item, value))" Clearable="true" Disabled="@(!CategoryHasValidityPeriod(context.Item))" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                </MudItem>
            </MudGrid>
        }
    </MudExpansionPanel>
    <MudExpansionPanel Text="Environment Description">
        <MudContainer Class="d-flex flex-column" style="max-width: 1000px; width: 100%;">
            <MudGrid>
                <MudItem xs="12" sm="3" md="3" lg="3">
                    <MudInputWithUnitAdornment QuantityName="DepthDrilling"
                                               @key="@($"ground-mud-depth-{_depthReferenceInputVersion}")"
                                               QuantityLabel="Ground/Mud Line Depth"
                                               DrillingSignalReference="@DrillingSignalReferenceType.Depth"
                                               SIValueNullable="groundMudLineDepthWGS84"
                                               SIValueNullableChanged="@ChangeGroundMudLineDepthWGS84" />
                </MudItem>
                <MudItem xs="12" sm="3" md="3" lg="3">
                    <MudInputWithUnitAdornment QuantityName="LengthSmall"
                                               QuantityLabel="Ground/Mud Line Accuracy"
                                               SIValueNullable="groundMudLineDepthAccuracy"
                                               SIValueNullableChanged="@(val => groundMudLineDepthAccuracy = val)" />
                </MudItem>
                <MudItem xs="12" sm="3" md="3" lg="3">
                    <MudInputWithUnitAdornment QuantityName="DepthDrilling"
                                               @key="@($"top-water-depth-{_depthReferenceInputVersion}")"
                                               QuantityLabel="Top Water Depth"
                                               DrillingSignalReference="@DrillingSignalReferenceType.Depth"
                                               SIValueNullable="topWaterDepthWGS84"
                                               SIValueNullableChanged="@ChangeTopWaterDepthWGS84" />
                </MudItem>
                <MudItem xs="12" sm="3" md="3" lg="3">
                    <MudInputWithUnitAdornment QuantityName="LengthSmall"
                                               QuantityLabel="Top Water Accuracy"
                                               SIValueNullable="topWaterDepthAccuracy"
                                               SIValueNullableChanged="@(val => topWaterDepthAccuracy = val)" />
                </MudItem>

            </MudGrid>
        </MudContainer>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Slots">
        <MudContainer Class="d-flex flex-column" style="max-width: 1000px; width: 100%;">
            <MudGrid>
                <MudItem xs="12" sm="2" md="2" lg="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddSlot" Class="mt-2">
                        Add Slot
                    </MudButton>
                </MudItem>
                <MudItem xs="12" sm="2" md="2" lg="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="RemoveSelectedSlots" Disabled="@(!_slots.Any(slot => slot.IsSelected))" Class="mt-2">
                        Delete Selected
                    </MudButton>
                </MudItem>
                <MudItem xs="12" sm="4" md="4" lg="4">
                    <MudInputWithUnitAdornment QuantityName="LengthSmall"
                                               QuantityLabel="Northing Accuracy"
                                               SIValueNullable="slotNorthingAccuracy"
                                               SIValueNullableChanged="@(val => slotNorthingAccuracy = val)" />
                </MudItem>
                <MudItem xs="12" sm="4" md="4" lg="4">
                    <MudInputWithUnitAdornment QuantityName="LengthSmall"
                                               QuantityLabel="Easting Accuracy"
                                               SIValueNullable="slotEastingAccuracy"
                                               SIValueNullableChanged="@(val => slotEastingAccuracy = val)" />
                </MudItem>
            </MudGrid>
            <MudTable Items="_slots" Hover="true" Dense="true" Bordered="true">
                <HeaderContent>
                    <MudTh>
                        <MudCheckBox T="bool" Value="@AreAllSlotsSelected" ValueChanged="@SetAllSlotsSelected" Dense="true" />
                    </MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>
                        <MudText>North</MudText>
                        <MudSpanUnitLabel QuantityName="PositionDrilling" VariantType="Variant.Text"
                                          DrillingSignalReference="@DrillingSignalReferenceType.Position" />
                    </MudTh>
                    <MudTh>
                        <MudText>East</MudText>
                        <MudSpanUnitLabel QuantityName="PositionDrilling" VariantType="Variant.Text"
                                          DrillingSignalReference="@DrillingSignalReferenceType.Position" />
                    </MudTh>
                    <MudTh>
                        <MudText>Latitude</MudText>
                        <MudSpanUnitLabel QuantityName="PlaneAngleGeodesic" VariantType="Variant.Text"
                                          DrillingSignalReference="@DrillingSignalReferenceType.Geodetic" />
                    </MudTh>
                    <MudTh>
                        <MudText>Longitude</MudText>
                        <MudSpanUnitLabel QuantityName="PlaneAngleGeodesic" VariantType="Variant.Text"
                                          DrillingSignalReference="@DrillingSignalReferenceType.Geodetic" />
                    </MudTh>
                    <MudTh>Features</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudCheckBox T="bool" Value="@context.IsSelected" ValueChanged="@((bool selected) => SetSlotSelected(context, selected))" Dense="true" />
                    </MudTd>
                    <MudTd>
                        <MudTextField @bind-Value="@context.Name"
                                      Variant="Variant.Text"
                                      Style="min-width:90px"
                                      Immediate="true" />
                    </MudTd>
                    <MudTd>
                        <MudInputWithUnit QuantityName="PositionDrilling"
                                          DrillingSignalReference="@DrillingSignalReferenceType.Position"
                                          PositionDirection="@PositionDirectionType.North"
                                          SIValueNullable="@context.Northing"
                                          SIValueNullableChanged="@(val => UpdateSlotNorthing(val, context))" />
                    </MudTd>
                    <MudTd>
                        <MudInputWithUnit QuantityName="PositionDrilling"
                                          DrillingSignalReference="@DrillingSignalReferenceType.Position"
                                          PositionDirection="@PositionDirectionType.East"
                                          SIValueNullable="@context.Easting"
                                          SIValueNullableChanged="@(val => UpdateSlotEasting(val, context))" />
                    </MudTd>
                    <MudTd>
                        <MudInputWithUnit QuantityName="PlaneAngleGeodesic"
                                          DrillingSignalReference="@DrillingSignalReferenceType.Geodetic"
                                          PositionDirection="@PositionDirectionType.North"
                                          SIValueNullable="@context.LatitudeWGS84"
                                          SIValueNullableChanged="@(val => UpdateSlotLatitudeWGS84(val, context))" />
                    </MudTd>
                    <MudTd>
                        <MudInputWithUnit QuantityName="PlaneAngleGeodesic"
                                          DrillingSignalReference="@DrillingSignalReferenceType.Geodetic"
                                          PositionDirection="@PositionDirectionType.East"
                                          SIValueNullable="@context.LongitudeWGS84"
                                          SIValueNullableChanged="@(val => UpdateSlotLongitudeWGS84(val, context))" />
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2" Style="min-width:140px">@GetSlotFeatureSummary(context)</MudText>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Style="width:25px"
                                       OnClick="@(()=>RemoveSlot(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
            @if (_slots.Count > 0 && _slotFeatureCategories.Count > 0)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">Slot Features</MudText>
                @if (SelectedSlotsForFeatureEditing.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="mb-2">Selected slots: @SelectedSlotsForFeatureEditing.Count</MudText>
                    <MudGrid Class="mt-2">
                        <MudItem xs="12" md="5">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Available</MudText>
                            <MudExpansionPanels MultiExpansion="true">
                                @foreach (SlotFeatureCategory category in _slotFeatureCategories)
                                {
                                    <MudExpansionPanel Text="@GetSlotFeatureCategoryDisplayName(category)">
                                        @foreach (SlotFeatureOption option in category.Options ?? [])
                                        {
                                            <MudButton Class="me-1 mb-1" Variant="@GetSlotFeatureOptionButtonVariant(category, option)" Color="@GetSlotFeatureOptionButtonColor(category, option)" Size="Size.Small" Disabled="@IsSlotFeatureOptionUnavailable(category)" OnClick="@(() => SelectSlotFeatureOption(category, option))">
                                                @option.Name
                                            </MudButton>
                                        }
                                    </MudExpansionPanel>
                                }
                            </MudExpansionPanels>
                        </MudItem>
                        <MudItem xs="12" md="2" Class="d-flex flex-column justify-center">
                            <MudButton Class="mb-2" Variant="Variant.Filled" Color="Color.Success" Disabled="@(!CanAssignSelectedSlotFeatureOption())" OnClick="AssignSelectedSlotFeatureOption">Assign</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(!_selectedSlotFeatureAssignmentId.HasValue)" OnClick="UnassignSelectedSlotFeature">Unassign</MudButton>
                        </MudItem>
                        <MudItem xs="12" md="5">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Selected</MudText>
                            <MudDataGrid T="SlotFeatureAssignment" Items="@SelectedSlotForFeatureEditing!.SlotFeatureAssignments" SelectedItem="@_selectedSlotFeatureAssignment" SelectedItemChanged="SetSelectedSlotFeatureAssignment" Hover="true" Dense="true" Elevation="0">
                                <Columns>
                                    <PropertyColumn Property="x => GetSlotFeatureAssignmentDisplayName(x)" Title="Name" Editable="false" />
                                    <TemplateColumn Title="From">
                                        <CellTemplate>
                                            <MudDatePicker Date="@ToDateTime(context.Item.FromDate)" DateChanged="@((DateTime? value) => SetSlotFeatureAssignmentFromDate(context.Item, value))" Clearable="true" Disabled="@(!SlotFeatureCategoryHasValidityPeriod(context.Item))" />
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="To">
                                        <CellTemplate>
                                            <MudDatePicker Date="@ToDateTime(context.Item.ToDate)" DateChanged="@((DateTime? value) => SetSlotFeatureAssignmentToDate(context.Item, value))" Clearable="true" Disabled="@(!SlotFeatureCategoryHasValidityPeriod(context.Item))" />
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                            </MudDataGrid>
                        </MudItem>
                    </MudGrid>
                }
            }
        </MudContainer>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Cluster Display">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RefreshPlots" Class="mt-2">Refresh Plots</MudButton>
        <MudGrid>
            <MudItem xs="12" sm="6" md="6" lg="6">
                <ScatterPlot NameList="@nameDepthList" ModeFlagList="@modeFlagDepthList" ColorList="@colorDepthList"
                             XValuesList="@xValuesDepthList" YValuesList="@yValuesDepthList"
                             YAxisReversed="@true" AspectRatio="-1" PlotHeight="500" PlotWidth="500"
                             PlotTitle="Depth References" XAxisTitle="@DataUtils.DepthReferencesXValuesTitle" YAxisTitle="@DataUtils.DepthReferencesYValuesTitle"
                             XUnit="@DataUtils.DepthReferencesXValuesQty" YUnit="@DataUtils.DepthReferencesYValuesQty"
                             YDrillingSignalReference="@DrillingSignalReferenceType.Depth"
                             @ref="@depthPlot"
                             ID="DepthPlot">
                </ScatterPlot>
            </MudItem>
            <MudItem xs="12" sm="6" md="6" lg="6">
                <ScatterPlot NameList="@nameSlotList" ModeFlagList="@modeFlagSlotList" ColorList="@colorSlotList"
                             XValuesList="@xValuesSlotList" YValuesList="@yValuesSlotList"
                             ShowLegends="@showSlotLegends" ShowMarkers="@showSlotMarkers"
                             YAxisReversed="@false" AspectRatio="1" PlotHeight="500" PlotWidth="500"
                             PlotTitle="Slots" XAxisTitle="@DataUtils.SlotsXValuesTitle" YAxisTitle="@DataUtils.SlotsYValuesTitle"
                             XUnit="@DataUtils.SlotsXValuesQty" YUnit="@DataUtils.SlotsYValuesQty"
                             @ref="@clusterPlot"
                             DrillingSignalReference="@DrillingSignalReferenceType.Position"
                             PositionDirectionX="@PositionDirectionType.East"
                             PositionDirectionY="@PositionDirectionType.North"
                             ID="SlotPlot">
                </ScatterPlot>
            </MudItem>
        </MudGrid>
    </MudExpansionPanel>
    </MudExpansionPanels>
</MudUnitAndReferenceChoiceTag>
@code {
    [Parameter]
    public Cluster? CurrentCluster { get; set; }

    [Parameter]
    public List<FieldLight>? Fields { get; set; }

    [Parameter]
    public List<Slot?>? AvailableSlotList { get; set; }

    [Parameter]
    public Action? OnUpdate { get; set; }

    // Local variables used to retrieve user-defined parameters
    private string? _name;
    private string? _descr;
    private FieldLight? _field;
    private MathPoint3DGlobalCoordinates _referencePoint = new();
    private double? referenceLatitudeWGS84 { get => _referencePoint.Latitude; set => _referencePoint.Latitude = value; }
    private double? referenceLongitudeWGS84 { get => _referencePoint.Longitude; set => _referencePoint.Longitude = value; }
    private double? referenceLatitudeDatum = null;
    private double? referenceLongitudeDatum = null;
    private double? referenceNorthing { get => _referencePoint.RiemannianNorth; set { _referencePoint.RiemannianNorth = value; ManageReferenceNorthingEasting(); } }
    private double? referenceEasting { get => _referencePoint.RiemannianEast; set { _referencePoint.RiemannianEast = value; ManageReferenceNorthingEasting(); } }
    private double? referenceDepthWGS84 { get => _referencePoint.TVD; set { _referencePoint.TVD = value; _referencePoint.Z = value; } }
    private double? referenceDepthDatum = null;
    private double? groundMudLineDepthWGS84 = null;
    private double? groundMudLineDepthAccuracy = null;
    private double? topWaterDepthWGS84 = null;
    private double? topWaterDepthAccuracy = null;
    private int _depthReferenceInputVersion = 0;
    private double? slotNorthingAccuracy = null;
    private double? slotEastingAccuracy = null;
    private List<SlotTemplate> _slots = new List<SlotTemplate>();

    private bool _isFixedPlatform = false;
    private bool _shouldLoadRigsAfterRender = false;
    private bool _disposed = false;
    private string? cleanClusterSnapshot_;
    private bool isRefreshingReferenceSources_;
    private bool hasPendingReferenceSourceRefresh_;

    private bool IsFixedPlatform
    {
        get
        {
            return _isFixedPlatform;
        }
        set
        {
            _isFixedPlatform = value;
        }
    }

    public void Dispose()
    {
        _disposed = true;
    }

    private RigLight? _rig = null;
    private List<RigLight> _rigs = new List<RigLight>();
    private List<ClusterIdentity> _clusterIdentities = new();
    private List<ClusterIdentityAssignment> _clusterIdentityAssignments = new();
    private Guid? _selectedIdentityId;
    private Guid? _selectedIdentityAssignmentId;
    private ClusterIdentityAssignment? _selectedIdentityAssignment;
    private List<ClusterFeatureCategory> _clusterFeatureCategories = new();
    private List<ClusterFeatureAssignment> _clusterFeatureAssignments = new();
    private Guid? _selectedFeatureCategoryId;
    private Guid? _selectedFeatureOptionId;
    private Guid? _selectedFeatureAssignmentId;
    private ClusterFeatureAssignment? _selectedFeatureAssignment;
    private List<SlotFeatureCategory> _slotFeatureCategories = new();
    private Guid? _selectedSlotFeatureCategoryId;
    private Guid? _selectedSlotFeatureOptionId;
    private Guid? _selectedSlotFeatureAssignmentId;
    private SlotFeatureAssignment? _selectedSlotFeatureAssignment;

    private List<SlotTemplate> SelectedSlotsForFeatureEditing =>
        _slots.Where(slot => slot.IsSelected).ToList();

    private SlotTemplate? SelectedSlotForFeatureEditing =>
        _slots.FirstOrDefault(slot => slot.IsSelected);

    private bool AreAllSlotsSelected => _slots.Count > 0 && _slots.All(slot => slot.IsSelected);

